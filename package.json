{
  "name": "dialogporten-frontend",
  "version": "1.184.2",
  "private": true,
  "scripts": {
    "hooks:enable": "git config core.hooksPath .hooks",
    "hooks:disable": "git config --unset core.hooksPath",
    "hooks:status": "if [ \"$(git config core.hooksPath)\" == \".hooks\" ]; then echo 'Git hooks is enabled'; else echo 'git hooks is disabled'; fi",
    "biome:fix-staged": "pnpm biome check --staged --no-errors-on-unmatched --write",
    "biome:fix": "pnpm biome check --no-errors-on-unmatched --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "lint-staged": "17.0.8",
    "mprocs": "0.9.2",
    "turbo": "2.9.14"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "lint-staged": {
    "**/*.*": "biome check --staged --no-errors-on-unmatched --write"
  },
  "packageManager": "pnpm@10.34.5",
  "msw": {
    "workerDirectory": [
      "dist"
    ]
  },
  "pnpm": {
    "overrides": {
      "@types/hast": "3.0.5",
      "mdast-util-gfm-autolink-literal": "2.0.0",
      "protobufjs": "8.8.1",
      "shell-quote": "1.12.0",
      "websocket-driver": "0.7.5",
      "brace-expansion@1": "1.1.16",
      "brace-expansion@2": "5.0.12",
      "brace-expansion@5": "5.0.12",
      "postcss@8": "8.5.32",
      "fast-uri@3": "3.1.9",
      "fast-uri@4": "4.2.3",
      "find-my-way@9": "9.10.0",
      "js-yaml@3": "3.15.1",
      "js-yaml@4": "4.3.2",
      "@graphql-tools/utils@<=12.0.0": "12.0.4",
      "@graphql-tools/utils@>=10.10.1 <=12.0.1": "12.0.4",
      "@azure/msal-node@>=5.0.0-beta.0 <7.1.0": "7.1.2"
    }
  }
}
