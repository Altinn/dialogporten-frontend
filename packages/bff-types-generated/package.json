{
  "name": "bff-types-generated",
  "main": "src/index.ts",
  "scripts": {
    "prepare": "pnpm generate:types-gql",
    "dev": "pnpm build:watch",
    "build": "pnpm generate:types-gql",
    "build:watch": "pnpm generate:types-gql --watch",
    "generate:types-gql": "graphql-codegen-esm --require ./register-ts.mjs --config codegen.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@graphql-codegen/cli": "7.4.6",
    "@graphql-codegen/typescript-operations": "6.2.0",
    "@graphql-tools/stitch": "catalog:",
    "@graphql-typed-document-node/core": "3.2.0",
    "@tsconfig/node24": "catalog:",
    "bff": "workspace:*",
    "graphql": "catalog:",
    "graphql-request": "catalog:",
    "graphql-tag": "^2.12.6"
  },
  "devDependencies": {
    "@graphql-codegen/typescript": "6.1.2",
    "@graphql-codegen/typescript-graphql-request": "7.1.0",
    "@graphql-codegen/typescript-resolvers": "6.1.1",
    "@parcel/watcher": "2.6.0",
    "@swc-node/register": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "type": "module"
}
